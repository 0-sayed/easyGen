# API HTTP port.
PORT=3000

# Structured logger level.
LOG_LEVEL=info

# Frontend development server port.
WEB_PORT=5173

# Backend API URL used by the frontend.
VITE_API_URL=http://127.0.0.1:3000

# MongoDB host port. The container keeps MongoDB on 27017 internally.
MONGODB_PORT=27018

# MongoDB connection string used by the API and migrations.
MONGODB_URI=mongodb://127.0.0.1:27018/easygen?directConnection=true

# JWT signing secret. Set this in local .env; tests set their own value.
JWT_SECRET=

# JWT access token lifetime.
JWT_EXPIRES_IN=15m

# Auth attempts allowed per email/IP window.
AUTH_THROTTLE_LIMIT=5

# Maximum in-memory auth throttle windows retained per API process.
AUTH_THROTTLE_MAX_ENTRIES=10000

# Auth throttle window duration in milliseconds.
AUTH_THROTTLE_WINDOW_MS=60000
